         symbol = query.symbol.upper()
         symbol = "^" + symbol if symbol in ["VIX", "RUT", "SPX", "NDX"] else symbol
 
+        def _fetch_chain_with_retry(t, expiration, tz=None, attempts=3):
+            """Yahoo's crumb/session occasionally fails transiently mid-request
+            (esp. under concurrent load), which yfinance surfaces as calls/puts
+            being None rather than raising. Retry a couple of times before
+            giving up on this one expiration, instead of crashing the whole
+            multi-expiration chain fetch over a single flaky call."""
+            import time  # noqa
+
+            last = None
+            for i in range(attempts):
+                last = t.option_chain(expiration, tz=tz) if tz is not None else t.option_chain(expiration)
+                if last[0] is not None and last[1] is not None and last[2] is not None:
+                    return last
+                if i < attempts - 1:
+                    time.sleep(0.4 * (i + 1))
+            return last
+
         def _get_all_data(symbol: str):
             """Get all options data in a single thread-safe operation."""
             t = Ticker(symbol)
