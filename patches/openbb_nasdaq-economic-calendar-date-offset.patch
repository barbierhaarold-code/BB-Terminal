 from pydantic import Field, field_validator
 
 
+def _corrected_datetime(bucket_date: str, gmt: str) -> str:
+    """BB-Terminal patch — correct Nasdaq's uniform one-day-late filing.
+
+    Nasdaq's ``economicevents?date=D`` endpoint returns every event (all
+    countries) under ``D = its real release date + 1 calendar day``. Confirmed
+    feed-wide: ~25 US indicators plus non-US anchors that cannot legitimately
+    move (Canada Labour Day, Brazil Independence Day, Bank of Russia decision,
+    CFTC COT, UK ONS monthly GDP, ECB decision), across two weeks including a
+    non-holiday week, with zero exceptions.
+
+    Shift the bucket date back one day and re-attach the clock time (already
+    US Eastern in Nasdaq's payload despite the ``gmt`` key), mirroring
+    upstream's All Day / Tentative / 24H handling.
+    """
+    # pylint: disable=import-outside-toplevel
+    from datetime import datetime, timedelta
+
+    real = (
+        datetime.strptime(bucket_date, "%Y-%m-%d") - timedelta(days=1)
+    ).strftime("%Y-%m-%d")
+    if gmt == "All Day":
+        return f"{real} 00:00"
+    return (
+        f"{real} {gmt}".replace("Tentative", "00:00").replace("24H", "00:00")
+    )
+
+
