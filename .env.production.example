# Production settings for docker-compose. Copy to `.env.production` (gitignored) on the
# server and fill in. NEVER commit real values. Every variable is listed below.
# Used as:  docker compose --env-file .env.production up -d --build

# ── Domain / HTTPS ─────────────────────────────────────────────
DOMAIN=terminal.example.com          # the DNS A record must point to the VPS
ACME_EMAIL=you@example.com           # Let's Encrypt expiry notices

# ── Supabase (login gate). PUBLIC values only: Project Settings > API ──
# These are baked into the browser bundle at build time. Never a service_role/secret key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ── Per-feature allowlists: comma-separated emails. Empty = locked for everyone ──
COPILOT_ALLOWED_EMAILS=
TWEETS_ALLOWED_EMAILS=
AIS_ALLOWED_EMAILS=

# ── Provider keys (all optional; a feature without its key shows an honest "unavailable") ──
TWELVE_DATA_API_KEY=                 # spot XAU/USD. Check licence before sharing with others
GETX_API_KEY=                        # Tweets tab. PAID per call (~$26/mo at default polling)
ANTHROPIC_API_KEY=                   # Copilot. PAID per token
FIRMS_MAP_KEY=                       # NASA FIRMS fires layer (free)
AISSTREAM_API_KEY=                   # live vessels (free, community-run, terms unconfirmed)
FMP_API_KEY=                         # Financial Modeling Prep, read by OpenBB (free tier is limited)
