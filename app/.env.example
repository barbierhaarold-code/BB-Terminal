# Copy to `.env` (gitignored) and fill in real values. Vite dev-server proxy
# plugins only — these keys never reach the client bundle (see vite.config.ts).

# Twelve Data — real spot XAU/USD for the gold intelligence panel / scalper.
# Free tier: 8 credits/minute. https://twelvedata.com
TWELVE_DATA_API_KEY=

# GetXAPI — Tweets tab (News Hub). Paid, per-call X/Twitter data reseller,
# $0.001/call on /twitter/user/tweets. At 9 tracked accounts polled every
# 15 minutes: ~25,920 calls/month ≈ $26/mo. https://docs.getxapi.com
GETX_API_KEY=

# Anthropic — AI Copilot chat panel (COPILOT). Pay-as-you-go, billed per
# token on the Claude API. https://console.anthropic.com
ANTHROPIC_API_KEY=

# NASA FIRMS — Active Fires layer (MAP). Free, no cost, tied to a free NASA
# Earthdata account. Register/generate a key at
# https://firms.modaps.eosdis.nasa.gov/api/area/ ("Get MAP_KEY").
FIRMS_MAP_KEY=

# AISStream.io — live vessel positions (MAP > Vessels layer). Free; sign in
# with GitHub at https://aisstream.io to generate a key. Community-run, no
# SLA, and its commercial-use terms are unconfirmed — fine for personal use,
# revisit before opening this terminal to other users. Leave blank and the
# layer shows an honest "feed unavailable" state.
AISSTREAM_API_KEY=
# Optional override of the WebSocket endpoint (testing against a local mock).
AISSTREAM_WS_URL=

# CFTC Socrata app token — OPTIONAL. COT data (COT page, Gold Intelligence, Quant,
# Copilot) comes from the CFTC's public API (publicreporting.cftc.gov), which needs
# no key. A free app token (https://publicreporting.cftc.gov/profile/edit/developer_settings)
# only raises Socrata's throttling limits; leave blank and everything still works.
CFTC_SOCRATA_APP_TOKEN=
# DEV-ONLY, never for production: set to 1 to enable POST /cot-proxy/_simulate (fake CFTC
# outage, to test the error state and the labeled Tradingster fallback). It is honored only
# by the Vite dev server (not the production gateway / Docker / `vite preview`, and not when
# NODE_ENV=production); anywhere else it is ignored and logged. Leave unset otherwise.
# COT_ALLOW_SIMULATE=1

# Macro Hub (/macro-proxy): DBnomics needs no key. Optional DEV-ONLY outage switch:
# MACRO_ALLOW_SIMULATE=1 enables POST /macro-proxy/_simulate?mode=outage|off[&clear=1]. Same gate as
# COT: honoured only by the Vite dev server (not the production gateway / Docker / `vite preview`,
# and not when NODE_ENV=production); anywhere else it is ignored and logged. Leave unset otherwise.
# MACRO_ALLOW_SIMULATE=1

# Supabase — login gate. Publishable (public) values only: Project Settings >
# API in the Supabase dashboard. These DO reach the client bundle (VITE_ prefix),
# which is fine for a publishable key. NEVER put a service_role/secret key here.
# Users are invited from the dashboard (Authentication > Users); the app has no
# signup. In Authentication > URL Configuration set Site URL to where the app is
# served (e.g. http://localhost:5173) so invite links land back here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side proxy auth (vite-plugins/auth.ts). Every proxy route requires a valid
# Supabase session token. These per-feature allowlists are comma-separated emails.
# An empty or missing list DENIES EVERYONE for that feature (and logs it at startup).
# A signed-in user not on the list gets 403 {"error":"feature_locked","feature":"..."}.
# Restart the dev server after editing. Never commit real addresses you want private.
COPILOT_ALLOWED_EMAILS=
TWEETS_ALLOWED_EMAILS=
AIS_ALLOWED_EMAILS=
