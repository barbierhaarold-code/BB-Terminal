# Copy to `.env` (gitignored) and fill in real values. Vite dev-server proxy
# plugins only — these keys never reach the client bundle (see vite.config.ts).

# Twelve Data — real spot XAU/USD for the gold intelligence panel / scalper.
# Free tier: 8 credits/minute. https://twelvedata.com
TWELVE_DATA_API_KEY=

# GetXAPI — Tweets tab (News Hub). Paid, per-call X/Twitter data reseller,
# $0.001/call on /twitter/user/tweets. At 9 tracked accounts polled every
# 15 minutes: ~25,920 calls/month ≈ $26/mo. https://docs.getxapi.com
GETX_API_KEY=

# Anthropic — AI Copilot chat panel (COPILOT). Pay-as-you-go, billed per
# token on the Claude API. https://console.anthropic.com
ANTHROPIC_API_KEY=

# NASA FIRMS — Active Fires layer (MAP). Free, no cost, tied to a free NASA
# Earthdata account. Register/generate a key at
# https://firms.modaps.eosdis.nasa.gov/api/area/ ("Get MAP_KEY").
FIRMS_MAP_KEY=
